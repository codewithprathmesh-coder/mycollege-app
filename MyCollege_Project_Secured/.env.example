# Server-side secrets: configure these in .env, never in client code or VITE_ variables.
GEMINI_API_KEY=

# Supabase project URL and publishable (formerly anon) key.
# The server-side health check reads SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required for encrypted, durable Express sessions. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
SESSION_ENCRYPTION_KEY=

# Server-side SMTP used to deliver Supabase-generated verification codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Used by the Vite client if a frontend feature imports src/supabaseClient.js.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

PORT=3000
